{
  "name": "stelmet/sap-rfc",
  "description": "SAP RFC connection library for PHP",
  "type": "library",
  "license": "proprietary",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Craig Hancock",
      "email": "c.hancock@grangefencing.co.uk"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": ">=8.3"
    }
  },
  "require": {
    "php": ">=8.3",
    "psr/log": "^3.0",
    "ext-intl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Stelmet\\SapRfc\\": "src/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "support": {
    "issues": "https://github.com/Stelmet-Org/stelmet-sap-rfc/issues",
    "source": "https://github.com/Stelmet-Org/stelmet-sap-rfc"
  }
}
